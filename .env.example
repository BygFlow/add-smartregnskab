# ─────────────────────────────────────────────────────────────
#  ADD SmartRegnskab — miljøvariabler
#  Kopier denne fil til .env og udfyld med rigtige værdier.
#  ALdrig commit .env til git!
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=production
APP_BASE_URL=https://app.addsmartregnskab.dk
VITE_API_BASE_URL=https://app.addsmartregnskab.dk
ALLOWED_ORIGINS=https://app.addsmartregnskab.dk,https://add-smartregnskab.onrender.com,https://localhost
PORT=5000

# Første platformadministrator oprettes kun, hvis der endnu ikke findes en.
PLATFORM_ADMIN_EMAIL=regnskab@addsmartregnskab.dk
PLATFORM_ADMIN_PASSWORD=
PLATFORM_COMPANY_NAME=ADD SmartDrift ApS
PLATFORM_COMPANY_CVR=46761898
PLATFORM_COMPANY_ADDRESS=Lynæs Søpark 49, 3390 Hundested
PLATFORM_INVOICE_EMAIL=regnskab@addsmartregnskab.dk

# ── Database & filer ──
# I produktion: peg mod persistent disk
# DATABASE_PATH=/var/data/data.db
# FILE_STORAGE_DIR=/var/data/files
# BACKUP_DIR=/var/data/backups
DATABASE_PATH=data.db
FILE_STORAGE_DIR=./uploads

# ── Kryptering (KRITISK) ──
# Generer med: openssl rand -hex 32
ENCRYPTION_KEY=

# Demo-data må kun aktiveres eksplicit i lokal udvikling.
ALLOW_DEMO_SEED=0

# ── QuickPay (abonnementer og betalinger) ──
# Brug en begrænset API-bruger. PRIVATE_KEY bruges kun til HMAC-kontrol af callbacks.
QUICKPAY_API_KEY=
QUICKPAY_PRIVATE_KEY=
QUICKPAY_SETUP_AMOUNT_ORE=0

# ── AiiA / Mastercard Open Banking (automatisk bankdata) ──
AIIA_CLIENT_ID=
AIIA_CLIENT_SECRET=
AIIA_BASE_URL=https://api.aiia.eu
AIIA_REDIRECT_URI=https://app.addsmartregnskab.dk/api/bank/aiia/callback
AIIA_SCOPES=accounts offline_access

# ── Email (SMTP — Simply.com) ──
SMTP_HOST=smtp.simply.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ADD SmartRegnskab <mail@addsmartregnskab.dk>
MAIL_REPLY_TO=

# ── Indgående bilagsmail ──
# Simply-bro: separat maskinpostkasse til bilag, som hentes via krypteret IMAP.
# Hver bilag-<token>-adresse skal routes til postkassen via en verificeret
# videresendelse eller en særskilt catch-all. Aktivér ikke catch-all på
# hoveddomænet uden at vurdere spam og uadresseret kundepost.
# Broen sender signeret JSON til POST /api/document-receiving/inbound.
# Signatur: HMAC-SHA256(secret, "<unix-timestamp>.<rå JSON-body>") i
# X-Document-Signature samt X-Document-Timestamp. Uden begge værdier vises
# ingen bilagsadresse for kunderne. SMTP alene kan ikke modtage bilagsmail.
DOCUMENT_INBOUND_DOMAIN=
DOCUMENT_INBOUND_WEBHOOK_SECRET=
# Sæt først true efter en rigtig ende-til-ende test af modtagebroen.
DOCUMENT_INBOUND_READY=false
# URL til denne app (HTTPS); brug særskilt baggrundsjob, ikke webprocessen.
DOCUMENT_INBOUND_API_URL=https://app.addsmartregnskab.dk
SIMPLY_DOCUMENT_IMAP_USER=
SIMPLY_DOCUMENT_IMAP_PASSWORD=

# ── AI-bilagslæsning (kræver også aktivt AI-tilkøb hos kunden) ──
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini

# Alternativ udbyder: Resend. Bruges kun når SMTP ikke er udfyldt.
RESEND_API_KEY=

# ── SMS (valgfrit) ──
SMS_API_URL=
SMS_API_KEY=

# ── MobilePay (valgfrit) ──
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_WEBHOOK_SECRET=

# ── S3-kompatibel objektlagring og ekstern backup ──
# Kræves før kundedrift. Bucket bør have versionering/Object Lock og en
# livscykluspolitik, der flytter ældre kopier til billig langtidslagring.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_BACKUP_PREFIX=smartregnskab/backups
S3_BACKUP_RETENTION_DAYS=35

# ── NemHandel / Peppol e-fakturering ──
# Afsendelse er fail-closed og kan ikke markeres som sendt uden et 2xx-svar
# fra en rigtig access-point-leverandør. URL og payloadkontrakt aftales med leverandøren.
EINVOICE_PROVIDER=generic
EINVOICE_PROVIDER_URL=
EINVOICE_PROVIDER_API_KEY=
# Anbefalet dansk fler-virksomhedsadapter: sæt EINVOICE_PROVIDER=sproom.
# Staging: https://staging.sproom.net/api — Produktion: https://sproom.net/api
# Én ISV Parent-aftale kan rumme alle kunders unikke CVR-profiler som child-companies.
# SPROOM_COMPANY_MAP forbinder internt virksomheds-ID med Sprooms child-company UUID,
# fx {"1":"e042e119-fd0c-4dd6-bf7e-02564c9fbd7b"}.
SPROOM_API_URL=https://sproom.net/api
SPROOM_API_TOKEN=
SPROOM_COMPANY_MAP={}
# Hentes via Sprooms GET /api/webhooks/key. Brug enten PEM direkte (med \n) eller base64 af hele PEM-filen.
SPROOM_WEBHOOK_PUBLIC_KEY=
SPROOM_WEBHOOK_PUBLIC_KEY_BASE64=
# Valgfri ekstern OIOUBL/Peppol-validator. Uden denne udføres kun lokal strukturkontrol.
EINVOICE_VALIDATOR_URL=
# Generer mindst 32 tilfældige bytes. Bruges til HMAC-SHA256 på indgående webhook.
EINVOICE_WEBHOOK_SECRET=

# ── Android release-signering (sættes i CI, aldrig i kildekoden) ──
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
