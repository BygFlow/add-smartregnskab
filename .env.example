# ─────────────────────────────────────────────────────────────
#  ADD SmartRegnskab — Miljøvariabler
#  Kopier denne fil til .env og udfyld med rigtige værdier.
#  ALdrig commit .env til git!
# ─────────────────────────────────────────────────────────────

# ── App ──
NODE_ENV=production
APP_BASE_URL=https://app.addsmartregnskab.dk
ALLOWED_ORIGINS=https://app.addsmartregnskab.dk,https://localhost
PORT=5000

# ── Database & filer ──
# I produktion: peg mod persistent disk
# DATABASE_PATH=/var/data/data.db
# FILE_STORAGE_DIR=/var/data/files
# BACKUP_DIR=/var/data/backups
DATABASE_PATH=data.db
FILE_STORAGE_DIR=./uploads

# ── Kryptering (KRITISK) ──
# Generer med: openssl rand -hex 32
ENCRYPTION_KEY=
# Valgfri separat backupnøgle; ellers bruges ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=

# Sæt til 1 bag én betroet reverse proxy (Render/nginx), ellers 0.
TRUST_PROXY=0

# ── Stripe (betalinger) ──
# Hent på: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ──
# Hent på: https://resend.com/api-keys
RESEND_API_KEY=
MAIL_FROM=noreply@addsmartregnskab.dk

# ── SMS (valgfrit) ──
SMS_API_URL=
SMS_API_KEY=

# ── MobilePay (valgfrit) ──
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_WEBHOOK_SECRET=

# ── S3 filstorage (valgfrit) ──
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
